{% assign app_settings = shop.metafields.future_trust.settings.value %}
{% assign threshold = app_settings.urgencyThreshold | default: block.settings.threshold %}
{% assign text_color = app_settings.urgencyTextColor | default: block.settings.text_color %}
{% assign bg_color = app_settings.urgencyBgColor | default: block.settings.bg_color %}
{% assign enabled = app_settings.urgencyEnabled %}

{% if enabled == nil %}
  {% assign enabled = true %} 
{% endif %}

{% if enabled %}
  <div 
    id="future-trust-urgency-{{ block.id }}" 
    class="future-trust-urgency-wrapper"
    style="display: none; margin: 10px 0;"
    data-threshold="{{ threshold }}"
    data-text="{{ app_settings.urgencyText | default: '🔥 Only [quantity] left in stock!' | escape }}"
  >
    <div class="future-trust-urgency-badge" style="
      color: {{ text_color }}; 
      background: {{ bg_color }};
      border: 1px solid {{ text_color | color_modify: 'alpha', 0.2 }};
    ">
      <span class="future-trust-icon">🔥</span>
      <span class="future-trust-message">Checking stock...</span>
    </div>
  </div>

  <style>
    .future-trust-urgency-badge {
      padding: 10px 14px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      line-height: 1.4;
      width: 100%;
      box-sizing: border-box;
      transition: all 0.3s ease;
    }
    .future-trust-icon {
      font-size: 1.2em;
      animation: futureTrustPulse 2s infinite;
    }
    @keyframes futureTrustPulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.1); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>

  <script>
    (function() {
      // 1. Build Inventory Map (Server-Side Rendered logic passed to Client)
      const inventoryMap = {
        {% for variant in product.variants %}
          "{{ variant.id }}": {{ variant.inventory_quantity | default: 0 }},
        {% endfor %}
      };

      const wrapper = document.getElementById('future-trust-urgency-{{ block.id }}');
      const messageEl = wrapper.querySelector('.future-trust-message');
      const threshold = parseInt(wrapper.dataset.threshold);
      const template = wrapper.dataset.text;

      // 2. Logic to Update UI
      function updateUrgency(variantId) {
        if (!variantId || inventoryMap[variantId] === undefined) {
          wrapper.style.display = 'none';
          return;
        }

        const qty = inventoryMap[variantId];

        // Logic: Show if low stock (>0 AND <= threshold)
        if (qty > 0 && qty <= threshold) {
          const msg = template.replace('[quantity]', qty);
          messageEl.textContent = msg;
          wrapper.style.display = 'block';
        } else {
          wrapper.style.display = 'none';
        }
      }

      // 3. Listen for Variant Changes (Best in Industry approach)
      // Method A: URL Params (Works on load & history changes)
      function checkUrl() {
        const params = new URLSearchParams(window.location.search);
        const variantId = params.get('variant') || "{{ product.selected_or_first_available_variant.id }}";
        updateUrgency(variantId);
      }

      // Method B: Listen for standard 3rd party events or global "change" on form
      // This is tricky as themes differ. URL polling + history listener is safest.
      
      // Init
      checkUrl();

      // Hook into pushState/replaceState to detect variant swaps that don't reload
      const originalPushState = history.pushState;
      history.pushState = function() {
        originalPushState.apply(this, arguments);
        setTimeout(checkUrl, 50);
      };

      const originalReplaceState = history.replaceState;
      history.replaceState = function() {
        originalReplaceState.apply(this, arguments);
        setTimeout(checkUrl, 50);
      };

      // Fallback: Listen for any change on the product form, just in case
      // standard themes update the URL, but some might not immediately
      document.addEventListener('change', (e) => {
        if (e.target.name === 'id' && e.target.closest('form[action*="/cart/add"]')) {
           updateUrgency(e.target.value);
        }
      });

    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Urgency Badge",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "paragraph", "content": "🎨 Manage styles in the App Dashboard" },
    { "type": "number", "id": "threshold", "label": "Fallback Threshold", "default": 10 },
    { "type": "color", "id": "text_color", "label": "Fallback Text", "default": "#D72C0D" },
    { "type": "color", "id": "bg_color", "label": "Fallback Background", "default": "#FFF4F2" }
  ]
}
{% endschema %}
