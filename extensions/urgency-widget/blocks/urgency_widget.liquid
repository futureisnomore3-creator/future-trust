{% assign app_settings = shop.metafields.future_trust.settings.value %}
{% assign threshold = app_settings.urgencyThreshold | default: block.settings.threshold %}
{% assign text_color = app_settings.urgencyTextColor | default: block.settings.text_color %}
{% assign bg_color = app_settings.urgencyBgColor | default: block.settings.bg_color %}
{% assign enabled = app_settings.urgencyEnabled %}

{% comment %} Handle "Enabled" check manually since JSON booleans can be tricky in Liquid {% endcomment %}
{% if enabled == nil %}
  {% assign enabled = true %} 
{% endif %}

{% if enabled %}
  {% assign inventory = product.selected_or_first_available_variant.inventory_quantity %}

  <div class="future-trust-urgency-container" style="margin: 15px 0;">
    {% if inventory == 0 %}
      <div class="future-trust-urgency oos" style="color: #666; background: #f4f4f4; padding: 12px; border-radius: 8px; font-weight: 600; text-align: center; border: 1px solid #ddd; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        🚫 This item is currently out of stock.
      </div>
    {% elsif inventory > 0 and inventory <= threshold %}
      {% assign urgency_text = app_settings.urgencyText | default: "🔥 Only {{ quantity }} left in stock - order soon!" %}
      {% assign final_msg = urgency_text | replace: "{{ quantity }}", inventory %}
      
      <div class="future-trust-urgency" style="color: {{ text_color }}; background: {{ bg_color }}; padding: 12px; border-radius: 8px; font-weight: 700; text-align: center; border: 1px solid {{ text_color }}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        {{ final_msg }}
      </div>
    {% endif %}
  </div>

  <style>
    .pulsing-fire {
      display: inline-block;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Urgency Widget",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "paragraph", "content": "⚠️ Settings are now managed in the FutureTrust App Dashboard." },
    { "type": "number", "id": "threshold", "label": "Fallback Threshold", "default": 10 },
    { "type": "color", "id": "text_color", "label": "Fallback Text Color", "default": "#D72C0D" },
    { "type": "color", "id": "bg_color", "label": "Fallback Background Color", "default": "#FFF4F2" }
  ]
}
{% endschema %}
