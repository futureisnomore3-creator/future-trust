{% assign app_settings = shop.metafields.future_trust.settings.value %}
{% assign sales_data = shop.metafields.future_trust.recent_sales.value %}
{% assign enabled = app_settings.socialEnabled %}

{% if enabled == nil %}
  {% assign enabled = true %}
{% endif %}

{% if enabled %}
  <div id="future-trust-sales-popup" class="future-trust-popup future-trust-hidden">
    <div class="future-trust-popup-content" id="ft-popup-click-target">
      <div class="future-trust-image-wrapper">
        <img id="ft-product-img" src="" alt="Product" class="future-trust-product-img" style="display:none">
        <div id="ft-product-placeholder" class="future-trust-placeholder" style="display:none">🛍️</div>
      </div>
      <div class="future-trust-text">
        <div>
          <span class="future-trust-name" id="ft-buyer-name">Someone</span> in <span class="future-trust-location" id="ft-buyer-location">...</span>
        </div>
        <div class="future-trust-subtext">
          <span class="future-trust-action" id="ft-action-text">purchased</span> <strong id="ft-product-name">...</strong>
        </div>
        <div class="future-trust-footer">
          <span class="future-trust-time" id="ft-time-ago">Just now</span>
          {% if app_settings.showVerified %}
            <span class="future-trust-verified">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg> Verified
            </span>
          {% endif %}
        </div>
      </div>
      <button class="future-trust-close" onclick="event.stopPropagation(); closeFuturePopup()">×</button>
    </div>
  </div>

  <style>
    /* Desktop Position */
    .future-trust-popup {
      position: fixed;
      z-index: 99999;
      background: {{ app_settings.urgencyBgColor | default: '#ffffff' }};
      color: {{ app_settings.text_color | default: '#1a1a1a' }};
      border-radius: 8px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.12);
      font-family: {{ settings.type_base_font.family }}, inherit;
      width: 340px;
      max-width: 92vw;
      border: 1px solid rgba(0,0,0,0.04);
      cursor: pointer;
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Position Logic from App Settings */
    {% case app_settings.desktopPosition %}
      {% when 'bottom_left' %}
        bottom: 20px; left: 20px; transform: translateY(20px);
      {% when 'bottom_right' %}
        bottom: 20px; right: 20px; transform: translateY(20px);
      {% when 'top_left' %}
        top: 20px; left: 20px; transform: translateY(-20px);
      {% when 'top_right' %}
        top: 20px; right: 20px; transform: translateY(-20px);
      {% else %}
        bottom: 20px; left: 20px; transform: translateY(20px);
    {% endcase %}

    .future-trust-popup.ft-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .future-trust-popup-content {
      display: flex;
      align-items: center;
      padding: 14px;
      position: relative;
    }

    .future-trust-image-wrapper {
      margin-right: 14px;
      flex-shrink: 0;
    }

    .future-trust-product-img {
      width: 56px;
      height: 56px;
      object-fit: cover;
      border-radius: 4px;
      display: block;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .future-trust-placeholder {
      width: 56px;
      height: 56px;
      background: #f4f4f4;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }

    .future-trust-text {
      font-size: 13px;
      line-height: 1.35;
      flex-grow: 1;
    }

    .future-trust-name, .future-trust-location {
      font-weight: 700;
    }

    .future-trust-footer {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    .future-trust-time {
      font-size: 11px;
      opacity: 0.7;
    }

    .future-trust-verified {
      font-size: 10px;
      display: flex;
      align-items: center;
      gap: 3px;
      color: #108043;
      background: #E3F1DF;
      padding: 2px 5px;
      border-radius: 4px;
      font-weight: 600;
    }

    .future-trust-close {
      position: absolute;
      top: 4px;
      right: 4px;
      background: none;
      border: none;
      font-size: 18px;
      cursor: pointer;
      color: inherit;
      opacity: 0.3;
      padding: 4px;
      line-height: 1;
    }
    
    .future-trust-close:hover {
      opacity: 1;
    }

    @media (max-width: 768px) {
      .future-trust-popup {
        width: calc(100% - 32px);
        left: 16px !important;
        right: 16px !important;
        
        {% if app_settings.mobilePosition == 'top' %}
          top: 10px !important;
          bottom: auto !important;
          transform: translateY(-20px);
        {% else %}
          top: auto !important;
          bottom: 10px !important;
          transform: translateY(20px);
        {% endif %}
      }
      
      .future-trust-popup.ft-visible {
        transform: translateY(0) !important;
      }

      {% if app_settings.hideMobile %}
        .future-trust-popup { display: none !important; }
      {% endif %}
    }
  </style>

  <script>
    (function() {
      // Config
      const rawSalesData = {{ sales_data | json }};
      const currentPageType = "{{ request.page_type }}";
      const currentProductId = "{{ product.id }}";
      const currentProductHandle = "{{ product.handle }}";
      const showCrossSells = {{ app_settings.crossSellEnabled | default: true }};
      
      let relevantSales = [];
      let crossSellProduct = null;

      // 1. Initial Filtering
      if (rawSalesData && Array.isArray(rawSalesData)) {
        if (currentPageType === 'product' && currentProductId) {
            relevantSales = rawSalesData.filter(s => 
                String(s.productId) === String(currentProductId) || 
                s.handle === currentProductHandle
            );
        } else {
            relevantSales = rawSalesData;
        }
      }

      // 2. AI Recommendation Fetcher
      async function fetchRecommendations() {
        if (!showCrossSells || currentPageType !== 'product' || !currentProductId) return;

        try {
          const response = await fetch(window.Shopify.routes.root + `recommendations/products.json?product_id=${currentProductId}&limit=2&intent=complementary`);
          const data = await response.json();
          
          if (data.products && data.products.length > 0) {
            crossSellProduct = data.products[0];
            const syntheticSale = {
                isCrossSell: true,
                product: crossSellProduct.title,
                url: crossSellProduct.url,
                image: crossSellProduct.featured_image,
                name: relevantSales.length > 0 ? relevantSales[0].name : "A shopper",
                location: relevantSales.length > 0 ? relevantSales[0].location : "Nearby"
            };
            relevantSales.push(syntheticSale);
          }
        } catch (e) {
          console.warn("FutureTrust: Cross-sell fetch failed", e);
        }
      }

      // 3. Fallback
      if (relevantSales.length === 0 && currentPageType !== 'product') {
         relevantSales = [
          { name: "Sarah", location: "New York", product: "this item", time: "2 minutes ago" }
        ];
      }

      // Elements
      const popup = document.getElementById('future-trust-sales-popup');
      const clickTarget = document.getElementById('ft-popup-click-target');
      const nameEl = document.getElementById('ft-buyer-name');
      const locEl = document.getElementById('ft-buyer-location');
      const prodEl = document.getElementById('ft-product-name');
      const actionEl = document.getElementById('ft-action-text');
      const timeEl = document.getElementById('ft-time-ago');
      const imgEl = document.getElementById('ft-product-img');
      const placeEl = document.getElementById('ft-product-placeholder');

      // Settings
      const delay = {{ app_settings.socialDelay | default: 3 }} * 1000;
      const duration = {{ app_settings.socialDuration | default: 5 }} * 1000;
      const interval = 10000; // Fixed interval or add to settings
      const currentProductImage = "{{ product.featured_image | image_url: width: 100 }}";

      window.scrollToCart = function() {
        const buyBtn = document.querySelector('form[action*="/cart/add"] button') || document.querySelector('[name="add"]');
        if (buyBtn) {
          buyBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
          buyBtn.style.transition = "transform 0.2s";
          buyBtn.style.transform = "scale(1.05)";
          setTimeout(() => buyBtn.style.transform = "scale(1)", 300);
        }
      };

      function updatePopupContent() {
        const sale = relevantSales[Math.floor(Math.random() * relevantSales.length)];
        
        nameEl.textContent = sale.name || "A customer";
        locEl.textContent = sale.location || "Nearby";
        prodEl.textContent = sale.product || "this product";
        
        if (sale.isCrossSell) {
            actionEl.textContent = "bought";
            prodEl.innerHTML = `${sale.product} <span style="font-weight:400; opacity:0.8;">with this!</span>`;
            clickTarget.onclick = function() { window.location.href = sale.url; };
            if (sale.image) {
                imgEl.src = sale.image;
                imgEl.style.display = 'block';
                placeEl.style.display = 'none';
            }
            timeEl.textContent = "Just now";
        } else {
            actionEl.textContent = "purchased";
            prodEl.textContent = sale.product || "this item";
            clickTarget.onclick = window.scrollToCart;

            if (currentPageType === 'product' && currentProductImage && currentProductImage !== "null") {
                imgEl.src = currentProductImage;
                imgEl.style.display = 'block';
                placeEl.style.display = 'none';
            } else {
                imgEl.style.display = 'none';
                placeEl.style.display = 'flex';
            }
            
            if (sale.time && sale.time.includes('T')) {
               const date = new Date(sale.time);
               const diff = Math.floor((new Date() - date) / 60000); 
               if (diff < 1) timeEl.textContent = "Just now";
               else if (diff < 60) timeEl.textContent = diff + " minutes ago";
               else timeEl.textContent = Math.floor(diff/60) + " hours ago";
            } else {
               timeEl.textContent = sale.time || "Recently";
            }
        }
      }

      function showPopup() {
        if (relevantSales.length === 0) return;
        updatePopupContent();
        popup.style.display = 'block';
        void popup.offsetWidth; 
        popup.classList.add('ft-visible');

        setTimeout(() => {
          popup.classList.remove('ft-visible');
          setTimeout(() => { popup.style.display = 'none'; }, 500); 
        }, duration);
      }

      // Initialize
      fetchRecommendations().then(() => {
          setTimeout(() => {
            showPopup();
            setInterval(showPopup, interval + duration);
          }, delay);
      });

      window.closeFuturePopup = function() {
        popup.classList.remove('ft-visible');
        setTimeout(() => { popup.style.display = 'none'; }, 500);
      };
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Recent Sales Popup",
  "target": "body",
  "settings": [
    { "type": "paragraph", "content": "✨ Managed via App Dashboard" }
  ]
}
{% endschema %}
